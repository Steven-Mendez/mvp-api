# Local mode (app/infrastructure/config.py): what `make up` and `make run` load. Nothing
# here is a secret; every value points at the local stack (local/compose.yaml).
ENVIRONMENT=local
LOG_LEVEL=DEBUG
DOCS_ENABLED=true

# moto accepts any credentials. The Makefile drops the shell's own AWS_* first, so
# these fake ones are all a local run carries.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL=http://localhost:5055

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mvp

# Fixed by moto's HASH id strategy; local/bootstrap.py checks them.
COGNITO_USER_POOL_ID=us-east-1_79afc1edf98fffac6c3f92f5749cabeb4a0376d8856fb
COGNITO_CLIENT_IDS=22fc7c718648b34d2c30d45fde,3dba8f674032f9adbea58d244a

# Unused locally: no CloudFront, so the origin header is not checked.
ORIGIN_VERIFY_SECRET=local

# mvp-web (vite, :3000) and mvp-mobile on the web (expo, :8081).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
WEB_BASE_URL=http://localhost:3000

MEDIA_BUCKET=mvp-api-local-media
MEDIA_BASE_URL=http://localhost:5055/mvp-api-local-media

# Unused locally: realtime events and invitation emails go to the log.
APPSYNC_HTTP_DOMAIN=localhost
MAIL_FROM=no-reply@localhost

RATE_LIMIT_TABLE=mvp-api-local-rate-limits
